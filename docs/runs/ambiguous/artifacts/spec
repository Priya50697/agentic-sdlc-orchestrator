{
  "title" : "Harden URL-checking service against abuse and external-check failures",
  "summary" : "The existing service accepts URLs and relies on external checks. It must be made safer against abuse (rate limiting and rejection of private/internal URLs, i.e. SSRF protection) and more reliable when external checks fail (timeouts, bounded retries, and a defined degraded response instead of an unhandled error).",
  "stories" : [ {
    "id" : "S1",
    "text" : "As a service operator, I want clients that send too many requests to be throttled, so that the service is protected from abuse."
  }, {
    "id" : "S2",
    "text" : "As a service operator, I want submitted URLs that point to private or internal addresses to be rejected, so that the service cannot be used to reach internal resources."
  }, {
    "id" : "S3",
    "text" : "As an API client, I want a clear and predictable response when an external check fails or is slow, so that I am not left with hangs or unexplained server errors."
  } ],
